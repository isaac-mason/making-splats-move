{
    "name": "making-splats-move",
    "private": true,
    "version": "0.0.0",
    "description": "Examples of making Gaussian splat scenes move: fire VFX, and more to come.",
    "license": "MIT",
    "author": "Isaac Mason",
    "type": "module",
    "packageManager": "pnpm@10.32.1",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "pnpm --filter fireplace dev",
        "build": "pnpm -r build",
        "lint": "biome check .",
        "format": "biome format --write .",
        "check": "biome check --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.0",
        "@types/three": "^0.185.0",
        "three": "^0.185.1",
        "typescript": "~6.0.2"
    },
    "pnpm": {
        "overrides": {
            "three": "$three",
            "@types/three": "$@types/three"
        }
    }
}
